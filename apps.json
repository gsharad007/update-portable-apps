// Combined app definitions for portable apps and installers.
// Comment out or remove entries to disable them.
//
// Field naming conventions:
//   portable_regex / installer_regex  — asset filter for that variant
//   portable_url   / installer_url    — direct download URL for that variant
//   portable_page_url / installer_page_url — scrape page when the two variants
//                                            live on different pages
//   page_url  (no prefix)  — shared scrape page when both variants are on the
//                            same page (paired with portable_regex/installer_regex)
//   github_repo / gitlab_repo — always shared; the regex fields select the asset
//
// update-portable-apps.py  loads entries that carry any  portable_*  field.
// update-installers.py     loads entries that carry any  installer_* field.
// An entry may carry both sets of fields and will be picked up by both scripts.
[
  // ─── GitHub-based apps ──────────────────────────────────────────────────
  {
    "name": "Rufus",
    "github_repo": "pbatard/rufus",
    "portable_regex": "rufus-[0-9.]+p\\.exe$",
    "installer_regex": "rufus-[0-9.]+\\.exe$"    // non-portable exe (no "p" suffix)
  },
  {
