// Combined app definitions for portable apps and installers.
//
// Source priority (most → least reliable):
//   1. winget_id / choco_id  — package managers, auto-discovers latest version
//   2. github_repo           — GitHub releases API, auto-discovers latest version
//   3. gitlab_repo           — GitLab releases API, auto-discovers latest version
//   4. page_url              — scrape HTML for download links
//   5. url                   — static/always-latest direct download URL
//
// Field naming conventions:
//   portable_*  fields  → picked up by update-portable-apps.py
//   installer_* fields  → picked up by update-installers.py
//   Unprefixed fields (name, github_repo, page_url, referer) are shared by both.
[
  // ─── GitHub-based apps (auto-discovers latest release) ─────────────────
  {
    "name": "Rufus",
    "github_repo": "pbatard/rufus",
    "portable_regex": "rufus-[0-9.]+p\\.exe$",
    "installer_regex": "rufus-[0-9.]+\\.exe$"
  },
  {
    "name": "VSCode",
    "github_repo": "portapps/vscode-portable",
    "portable_regex": "vscode-portable-win64\\.exe$"
  },
